# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...

# === Web search ===
TAVILY_API_KEY=tvly-...

# === OCR (chọn 1) ===
MISTRAL_API_KEY=

# === Database (Railway tự inject khi link service Postgres) ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valuation?schema=public

# === Redis (Railway tự inject khi link service Redis) ===
REDIS_URL=redis://localhost:6379

# === Storage ===
# Option A: Railway volume — set STORAGE_DRIVER=local + STORAGE_PATH
# Option B: Cloudflare R2 — set STORAGE_DRIVER=r2 + R2_*
STORAGE_DRIVER=local
STORAGE_PATH=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# === Auth ===
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Misc ===
NODE_ENV=development
LOG_LEVEL=info
JOB_TIMEOUT_MS=1200000
